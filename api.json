    "components": {
        "schemas": {
            "CreateInvoiceRequest": {
                "type": "object",
                "properties": {
                    "customer_name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "customer_email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "product_lines": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "maxLength": 255
                                },
                                "quantity": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 2147483647
                                },
                                "unit_price": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 2147483647
                                }
                            },
                            "required": [
                                "name",
                                "quantity",
                                "unit_price"
                            ]
                        },
                        "maxItems": 1000
                    }
                },
                "required": [
                    "customer_name",
                    "customer_email"
                ],
                "title": "CreateInvoiceRequest"
            },
            "InvoiceProductLineResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "quantity": {
                        "type": "integer"
                    },
                    "unit_price": {
                        "type": "integer"
                    },
                    "total_unit_price": {
                        "type": "integer"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "quantity",
                    "unit_price",
                    "total_unit_price"
                ],
                "title": "InvoiceProductLineResource"
            },
            "InvoiceResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "status": {
                        "$ref": "#/components/schemas/StatusEnum"
                    },
                    "customer_name": {
                        "type": "string"
                    },
                    "customer_email": {
                        "type": "string"
                    },
                    "product_lines": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/InvoiceProductLineResource"
                        }
                    },
                    "total_price": {
                        "type": "integer"
                    }
                },
                "required": [
                    "id",
                    "status",
                    "customer_name",
                    "customer_email",
                    "product_lines",
                    "total_price"
                ],
                "title": "InvoiceResource"
            },
            "StatusEnum": {
                "type": "string",
                "enum": [
                    "draft",
                    "sending",
                    "sent-to-client"
                ],
                "title": "StatusEnum"
            }
        },
        "responses": {
            "NotFoundHttpException": {
                "description": "Not found",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            }
        }
    }
