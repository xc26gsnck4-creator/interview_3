includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/shipmonk/dead-code-detector/rules.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-insecure-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-loose-calls.neon
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - app
        - src
        - database
        - tests
    checkModelProperties: true
    parseModelCastsMethod: true

    # Usages from tests do not count, so a member only tests call is reported.
    # Members a later ticket will consume live in phpstan-baseline.neon and the
    # ticket that consumes them removes their entry (unmatched entries fail).
    shipmonkDeadCode:
        usageExcluders:
            tests:
                enabled: true

    ignoreErrors:
        # Factory states exist for tests; being used only by tests is their job.
        -
            identifier: shipmonk.deadMethod
            message: '#^Unused Database\\Factories\\.+ \(all usages excluded by tests excluder\)$#'
            paths:
                - database/factories/*
            reportUnmatched: false
        # Services are built by the container, which the detector cannot see.
        -
            identifier: shipmonk.deadMethod
            message: '#^Unused .+::__construct( \(all usages excluded by tests excluder\))?$#'
            paths:
                - src/Modules/*/Application/*
                - src/Modules/*/Infrastructure/*
            reportUnmatched: false

    disallowedFunctionCalls:
        -
            function:
                - 'dd()'
                - 'dump()'
                - 'ray()'
                - 'var_dump()'
                - 'print_r()'
            message: 'debug output must not be committed'

    # Larastan resolves facade calls to the underlying class, so the Connection
    # entries also catch DB::raw(), DB::statement() and DB::unprepared().
    disallowedStaticCalls:
        -
            method:
                - 'Illuminate\Database\Connection::raw()'
                - 'Illuminate\Database\Connection::statement()'
                - 'Illuminate\Database\Connection::unprepared()'
            message: 'raw SQL bypasses bindings; use the query builder'

    disallowedMethodCalls:
        -
            method:
                - 'Illuminate\Database\Connection::raw()'
                - 'Illuminate\Database\Connection::statement()'
                - 'Illuminate\Database\Connection::unprepared()'
                - 'Illuminate\Database\Query\Builder::*Raw()'
                - 'Illuminate\Database\Eloquent\Builder::*Raw()'
            message: 'raw SQL bypasses bindings; use the query builder'
