includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpat/phpat/extension.neon

parameters:
    level: max
    # Fixed so `composer phpstan` can wipe exactly this directory before each
    # run (see the script's description in composer.json).
    tmpDir: /tmp/phpstan-interview-task
    paths:
        - app
        - src
        - database
        - tests
    checkModelProperties: true
    parseModelCastsMethod: true

    # ignore_built_in_classes stays false (the default): true also drops the
    # relation to a built-in parent such as DomainException, so a "should
    # extend" rule fails on classes that do extend it.
    phpat:
        show_rule_names: true

    ignoreErrors:
        # Larastan models every Query\Builder method forwarded through an
        # Eloquent builder or relation as static (EloquentBuilderMethodReflection),
        # so strict-rules would flag $invoice->productLines()->count(). The entry
        # is tied to the builder class, so Model::query() called dynamically, own
        # static methods and PHPUnit assertions are still reported.
        -
            identifier: staticMethod.dynamicCall
            message: '#^Dynamic call to static method Illuminate\\Database\\Eloquent\\Builder(<.*>)?::#'
            reportUnmatched: false

services:
    # Architecture rules (phpat), the layer and module map included.
    -
        class: Tests\Architecture\InvoicesArchitectureRules
        tags:
            - phpat.test
