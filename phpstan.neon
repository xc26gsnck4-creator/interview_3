includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/shipmonk/dead-code-detector/rules.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-insecure-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-loose-calls.neon
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - app
        - src
        - database
        - tests
    checkModelProperties: true
    parseModelCastsMethod: true

    # Members a later ticket will consume live in phpstan-baseline.neon; the
    # ticket that consumes them removes their entry (unmatched entries fail).
    shipmonkDeadCode:
        usageExcluders:
            tests:
                enabled: true
                # Factories are test support like tests/ (the autoload-dev default).
                devPaths:
                    - tests
                    - database/factories
        usageProviders:
            # Auto-enabled by transitive symfony/* and nette/utils packages.
            symfony:
                enabled: false
            nette:
                enabled: false

    ignoreErrors:
        # Classes the container binds or autowires (scoped(Interface, Impl),
        # constructor injection) have no `new` the detector can see.
        -
            identifier: shipmonk.deadMethod
            message: '#^Unused .+::__construct#'
            paths:
                - src/Modules/*/Application/*
                - src/Modules/*/Infrastructure/*
            reportUnmatched: false
        # Larastan models every Query\Builder method forwarded through an
        # Eloquent builder or relation as static (EloquentBuilderMethodReflection),
        # so strict-rules would flag $invoice->productLines()->count(). The entry
        # is tied to the builder class, so Model::query() called dynamically, own
        # static methods and PHPUnit assertions are still reported.
        -
            identifier: staticMethod.dynamicCall
            message: '#^Dynamic call to static method Illuminate\\Database\\Eloquent\\Builder(<.*>)?::#'
            reportUnmatched: false

    # The bundled dangerous set already covers var_dump() and print_r().
    disallowedFunctionCalls:
        -
            function:
                - 'dd()'
                - 'dump()'
                - 'ray()'
            message: 'debug output must not be committed'

    # Instance calls. The same lists appear under disallowedStaticCalls because
    # spaze keeps the two call kinds apart and Larastan resolves static calls on
    # a model (Invoice::whereRaw(), Invoice::dd()) to the Eloquent builder and
    # DB facade calls to the connection; an entry on the facade name never
    # matches. One ConnectionInterface entry covers DB::select(), the facade's
    # DB::connection() and an injected connection alike; selectFromWriteConnection()
    # and selectResultSets() exist only on the concrete Connection.
    disallowedMethodCalls:
        -
            method:
                - '*::dd()'
                - '*::dump()'
                - '*::ddRawSql()'
                - '*::dumpRawSql()'
            message: 'debug output must not be committed'
        -
            method:
                - 'Illuminate\Database\ConnectionInterface::raw()'
                - 'Illuminate\Database\ConnectionInterface::select()'
                - 'Illuminate\Database\ConnectionInterface::selectOne()'
                - 'Illuminate\Database\ConnectionInterface::scalar()'
                - 'Illuminate\Database\ConnectionInterface::cursor()'
                - 'Illuminate\Database\ConnectionInterface::insert()'
                - 'Illuminate\Database\ConnectionInterface::update()'
                - 'Illuminate\Database\ConnectionInterface::delete()'
                - 'Illuminate\Database\ConnectionInterface::statement()'
                - 'Illuminate\Database\ConnectionInterface::affectingStatement()'
                - 'Illuminate\Database\ConnectionInterface::unprepared()'
                - 'Illuminate\Database\Connection::selectFromWriteConnection()'
                - 'Illuminate\Database\Connection::selectResultSets()'
                - 'Illuminate\Database\Query\Builder::*Raw()'
                - 'Illuminate\Database\Eloquent\Builder::*Raw()'
            message: 'hand-written SQL is not allowed; use the query builder or Eloquent'

    disallowedStaticCalls:
        -
            method:
                - '*::dd()'
                - '*::dump()'
                - '*::ddRawSql()'
                - '*::dumpRawSql()'
            message: 'debug output must not be committed'
        -
            method:
                - 'Illuminate\Database\ConnectionInterface::raw()'
                - 'Illuminate\Database\ConnectionInterface::select()'
                - 'Illuminate\Database\ConnectionInterface::selectOne()'
                - 'Illuminate\Database\ConnectionInterface::scalar()'
                - 'Illuminate\Database\ConnectionInterface::cursor()'
                - 'Illuminate\Database\ConnectionInterface::insert()'
                - 'Illuminate\Database\ConnectionInterface::update()'
                - 'Illuminate\Database\ConnectionInterface::delete()'
                - 'Illuminate\Database\ConnectionInterface::statement()'
                - 'Illuminate\Database\ConnectionInterface::affectingStatement()'
                - 'Illuminate\Database\ConnectionInterface::unprepared()'
                - 'Illuminate\Database\Connection::selectFromWriteConnection()'
                - 'Illuminate\Database\Connection::selectResultSets()'
                - 'Illuminate\Database\Query\Builder::*Raw()'
                - 'Illuminate\Database\Eloquent\Builder::*Raw()'
            message: 'hand-written SQL is not allowed; use the query builder or Eloquent'
