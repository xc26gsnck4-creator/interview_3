{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.24",
        "infection/infection": "^0.35",
        "larastan/larastan": "^3.13",
        "laravel/boost": "*",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.44",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "phpat/phpat": "^0.12",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^11",
        "rector/rector": "^2.7",
        "shipmonk/dead-code-detector": "^1.4",
        "spaze/phpstan-disallowed-calls": "^4.15",
        "tomasvotruba/type-coverage": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "src/Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "phpstan": "rm -rf /tmp/phpstan-interview-task && phpstan analyse --no-progress --memory-limit=1G",
        "deptrac": "deptrac analyse --no-progress",
        "infection": "infection --show-mutations --no-progress"
    },
    "scripts-descriptions": {
        "phpstan": "Runs PHPStan from a cold tmpDir (phpstan.neon): under Docker Desktop its caches trust a stale directory stat and can skip new files.",
        "deptrac": "Checks the layer and module map in deptrac.yaml.",
        "infection": "Mutation-tests the Invoices module; fails below 100% covered MSI (infection.json5)."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
